\input regression-test.tex
\documentclass{book}
\usepackage[perfil=livro]{abntex3}
\ABNTEXlivroautor{Ana Silva}{autora}
\ABNTEXlivroautor{Bruno Lima}{organizador}
\ABNTEXlivrocolaborador{Carla Souza}{tradutora}

\begin{document}
\START
\ExplSyntaxOn
\TYPE{authors=\seq_count:N \g__abntex_book_authors_seq}
\TYPE{contributors=\seq_count:N \g__abntex_book_contributors_seq}
\TYPE{metadata=\ABNTEXmetadata{autoria}}
\cs_set_protected:Npn \__abntex_book_person:nn #1#2
  {\TYPE{person=#1|#2}}
\seq_map_inline:Nn \g__abntex_book_authors_seq {#1}
\seq_map_inline:Nn \g__abntex_book_contributors_seq {#1}
\ExplSyntaxOff
\END
\end{document}
