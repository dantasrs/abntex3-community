\ABNTEXresumo{Texto vernaculo}{primeira, segunda}
\ABNTEXresumoemlinguaestrangeira
  [Abstract][Keywords]{Foreign text}{first, second}
\prop_map_inline:Nn \g__abntex_frontmatter_seen_prop
  {\TYPE{seen=#1}}
\TYPE{last-rank=\int_use:N \g__abntex_frontmatter_rank_int}
