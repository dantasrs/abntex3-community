% \maketitle
%
% \begin{documentation}
%
% \section{Estado}
%
% A versão 0.0.0 oferece a API mínima de configuração e metadados e módulos
% dedicados a layout, paginação, seções, elementos pré-textuais e listas. A
% implementação possui rastreabilidade para a ABNT NBR 14724:2024, a ABNT NBR
% 6024:2012, a ABNT NBR 6027:2012, a ABNT NBR 6028:2021 e a ABNT NBR
% 12225:2023. O fluxo pós-textual coordena o \pkg{biblatex-abnt}, referências,
% glossário, apêndices, anexos e índice. Os perfis acadêmico, de projeto de
% pesquisa e de artigo coordenam esses recursos em fluxos completos. A implementação
% ainda depende de revisão normativa independente e não faz alegação de
% conformidade.
%
% \section{Uso mínimo}
%
% \begin{verbatim}
% \documentclass{article}
% \usepackage[perfil=academico,tipo-trabalho=dissertacao]{abntex3}
% \ABNTEXsetup{
%   titulo      = {Título},
%   autoria     = {Nome},
%   instituicao = {Instituição}
% }
% \end{verbatim}
%
% Opções do pacote são processadas primeiro. Chamadas posteriores de
% \cs{ABNTEXsetup} substituem os valores anteriores, e entre chamadas
% sucessivas prevalece a última atribuição de cada chave.
%
% A referência completa das chaves está no manual do núcleo.
%
% \end{documentation}
%
% \begin{implementation}
%
% \section{Implementação}
%
%    \begin{macrocode}
%<@@=abntex>
%<*package>
\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesExplPackage{abntex3}
  {2026-07-29}{0.0.0}{Nucleo estrutural do abnTeX3 Community}

\RequirePackage{abntex3-core}
\RequirePackage{abntex3-layout}
\RequirePackage{abntex3-structure}
\RequirePackage{abntex3-frontmatter}
\RequirePackage{abntex3-lists}
\RequirePackage{abntex3-backmatter}
\RequirePackage{abntex3-profile-academic}
\RequirePackage{abntex3-profile-project}
\RequirePackage{abntex3-profile-article}
\RequirePackage{l3keys2e}

\ProcessKeysOptions{abntex3}
\abntex_core_initialize:
\abntex_backmatter_initialize:
\hook_gput_code:nnn {begindocument/before} {abntex3-structure}
  {\abntex_structure_initialize:}
\hook_gput_code:nnn {begindocument/before} {abntex3-layout}
  {\__abntex_layout_initialize:}
\endinput
%</package>
%    \end{macrocode}
%
% \end{implementation}
