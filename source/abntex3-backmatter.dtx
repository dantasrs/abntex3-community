%
% \title{\pkg{abntex3-backmatter}: elementos pós-textuais e bibliografia}
% \author{dantasrs}
% \date{2026-08-03 v0.1.0-alpha.1}
%
% \maketitle
%
% \begin{documentation}
%
% \section{Escopo}
%
% O módulo coordena referências, glossário, apêndices, anexos e índice. Os
% estilos de citação e referência continuam sendo responsabilidade do
% \pkg{biblatex-abnt}; nenhuma implementação bibliográfica é copiada para o
% abnTeX3 Community.
%
% A rastreabilidade considera a ABNT NBR 6023:2025, a ABNT NBR 10520:2023 e
% a ABNT NBR 6034:2004. A implementação ainda requer revisão normativa
% independente e não constitui alegação de conformidade.
%
% \section{Integração bibliográfica}
%
% A chave |citacoes| aceita |externo|, |autor-data| ou |numerico|. O valor
% inicial |externo| não carrega \pkg{biblatex}; assim, nenhuma escolha de
% estilo ocorre silenciosamente. Os outros valores carregam explicitamente
% \pkg{biblatex} com |style=abnt| ou |style=abnt-numeric| e |backend=biber|.
%
% Se o usuário carregar \pkg{biblatex} antes do abnTeX3, as opções existentes
% são preservadas e a compatibilidade com a chave solicitada é verificada.
%
% \begin{function}{\ABNTEXbibliografia}
%   \begin{syntax}
%     \cs{ABNTEXbibliografia}\oarg{título}\oarg{opções de printbibliography}
%   \end{syntax}
%   Cria o título pós-textual, a entrada no sumário e delega a lista a
%   \cs{printbibliography}. A lista usa espaço simples, alinhamento à esquerda
%   e uma linha simples entre referências.
% \end{function}
%
% \section{Fluxo pós-textual}
%
% \begin{function}{\ABNTEXposttextualpages}
%   Inicia a parte pós-textual sem reiniciar a paginação.
% \end{function}
%
% \begin{function}{\ABNTEXglossario}
%   \begin{syntax}
%     \cs{ABNTEXglossario}\oarg{título}\oarg{opções de printglossary}
%   \end{syntax}
%   Delega a geração a \pkg{glossaries} ou \pkg{glossaries-extra}, quando um
%   deles tiver sido carregado pelo usuário.
% \end{function}
%
% \begin{function}{\ABNTEXindice}
%   \begin{syntax}
%     \cs{ABNTEXindice}\oarg{título}
%   \end{syntax}
%   Delega a geração a \pkg{makeidx}, \pkg{imakeidx} ou implementação
%   compatível carregada pelo usuário.
% \end{function}
%
% \end{documentation}
%
% \begin{implementation}
%
% \section{Implementação}
%
%    \begin{macrocode}
%<@@=abntex>
%<*package>
\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesExplPackage{abntex3-backmatter}
  {2026-08-03}{0.1.0-alpha.1}
  {Elementos pos-textuais e bibliografia do abnTeX3 Community}

\tl_new:N \g__abntex_citation_system_tl
\int_new:N \g__abntex_backmatter_rank_int
\prop_new:N \g__abntex_backmatter_seen_prop
\bool_new:N \g__abntex_bibliography_ready_bool
\bool_new:N \g__abntex_bibliography_version_bool

\tl_gset:Nn \g__abntex_citation_system_tl {externo}

\msg_new:nnnn {abntex3} {bibliography-not-configured}
  {A~bibliografia~nao~esta~configurada.}
  {
    Carregue~biblatex~explicitamente~ou~selecione~
    citacoes=autor-data|numerico.
  }
\msg_new:nnnn {abntex3} {bibliography-style-incompatible}
  {O~estilo~bibliografico~carregado~e~incompativel~com~'#1'.}
  {Use~o~estilo~'#2'~ou~altere~a~chave~citacoes.}
\msg_new:nnnn {abntex3} {bibliography-version-insufficient}
  {A~versao~de~'#1'~e~anterior~a~minima~testada~(#2).}
  {Atualize~a~distribuicao~TeX~antes~de~usar~a~integracao.}
\msg_new:nnnn {abntex3} {bibliography-files-missing}
  {Os~estilos~do~biblatex-abnt~nao~foram~encontrados.}
  {Instale~biblatex-abnt~ou~use~citacoes=externo.}
\msg_new:nnnn {abntex3} {biber-output-missing}
  {O~arquivo~bibliografico~'#1.bbl'~nao~foi~encontrado.}
  {Execute~biber~#1~e~compile~o~documento~novamente.}
\msg_new:nnnn {abntex3} {backmatter-integration-missing}
  {O~comando~de~integracao~'#1'~nao~esta~disponivel.}
  {Carregue~o~pacote~responsavel~antes~de~usar~'#2'.}
\msg_new:nnnn {abntex3} {backmatter-order}
  {O~elemento~pos-textual~'#1'~esta~fora~da~ordem~recomendada.}
  {Revise~a~sequencia~definida~na~ABNT~NBR~14724:2024.}

\keys_define:nn {abntex3}
  {
    citacoes .choices:nn = {externo, autor-data, numerico}
      {\tl_gset:Nx \g__abntex_citation_system_tl {\l_keys_choice_tl}},
    citacoes .initial:n = externo
  }

\cs_new_protected:Npn \__abntex_backmatter_register:nn #1#2
  {
    \int_compare:nNnT {#1} < {\g__abntex_backmatter_rank_int}
      {\msg_warning:nnn {abntex3} {backmatter-order} {#2}}
    \int_gset:Nn \g__abntex_backmatter_rank_int
      {\int_max:nn {#1} {\g__abntex_backmatter_rank_int}}
    \prop_gput:Nnn \g__abntex_backmatter_seen_prop {#2} {true}
  }

\cs_new:Npn \__abntex_backmatter_expected_style:
  {
    \str_case:Vn \g__abntex_citation_system_tl
      {
        {autor-data} {abnt}
        {numerico} {abnt-numeric}
      }
  }

\prg_new_conditional:Npnn \__abntex_backmatter_style_matches: {T,F,TF}
  {
    \tl_set:Nx \l_tmpa_tl {\__abntex_backmatter_expected_style:}
    \cs_if_exist:cTF {blx@bbxfile}
      {
        \tl_set:Nx \l_tmpb_tl {\use:c {blx@bbxfile}}
        \cs_if_exist:cTF {blx@cbxfile}
          {
            \tl_set:Nx \l_tmpc_tl {\use:c {blx@cbxfile}}
            \bool_lazy_and:nnTF
              {\tl_if_eq_p:NN \l_tmpa_tl \l_tmpb_tl}
              {\tl_if_eq_p:NN \l_tmpa_tl \l_tmpc_tl}
              {\prg_return_true:}
              {\prg_return_false:}
          }
          {\prg_return_false:}
      }
      {\prg_return_false:}
  }

\cs_new_protected:Npn \__abntex_backmatter_check_style:
  {
    \tl_if_eq:NnF \g__abntex_citation_system_tl {externo}
      {
        \__abntex_backmatter_style_matches:F
          {
            \msg_error:nnxx {abntex3} {bibliography-style-incompatible}
              {\tl_use:N \g__abntex_citation_system_tl}
              {\__abntex_backmatter_expected_style:}
          }
      }
  }

\cs_new_protected:Npn \__abntex_backmatter_check_versions:
  {
    \bool_gset_true:N \g__abntex_bibliography_version_bool
    \@ifpackagelater {biblatex} {2021/12/31}
      {}
      {
        \bool_gset_false:N \g__abntex_bibliography_version_bool
        \msg_warning:nnnn {abntex3} {bibliography-version-insufficient}
          {biblatex} {2022-01-01}
      }
    \cs_if_exist:cT {ver@abnt.bbx}
      {
        \IfFileAtLeastTF {abnt.bbx} {2018-11-17}
          {}
          {
            \bool_gset_false:N \g__abntex_bibliography_version_bool
            \msg_warning:nnnn {abntex3} {bibliography-version-insufficient}
              {biblatex-abnt} {2018-11-17}
          }
      }
  }

\cs_new_protected:Npn \__abntex_backmatter_check_declared_version:nnn
  #1#2#3
  {
    \@ifl@t@r {#2} {#3}
      {}
      {
        \bool_gset_false:N \g__abntex_bibliography_version_bool
        \msg_warning:nnnn {abntex3} {bibliography-version-insufficient}
          {#1} {#3}
      }
  }

\cs_new_protected:Npn \__abntex_backmatter_install_bibliography_format:
  {
    \AtBeginBibliography
      {
        \setstretch{1}
        \raggedright
        \setlength{\bibitemsep}{\baselineskip}
      }
  }

\cs_new_protected:Npn \__abntex_backmatter_after_biblatex:
  {
    \bool_if:NF \g__abntex_bibliography_ready_bool
      {
        \bool_gset_true:N \g__abntex_bibliography_ready_bool
        \__abntex_backmatter_check_versions:
        \__abntex_backmatter_check_style:
        \__abntex_backmatter_install_bibliography_format:
      }
  }

\cs_new_protected:Npn \__abntex_backmatter_load_bibliography:
  {
    \tl_if_eq:NnF \g__abntex_citation_system_tl {externo}
      {
        \IfFileExists{abnt.bbx}
          {
            \@ifpackageloaded {biblatex}
              {}
              {
                \tl_if_eq:NnTF
                  \g__abntex_citation_system_tl {autor-data}
                  {\PassOptionsToPackage{backend=biber,style=abnt}{biblatex}}
                  {
                    \PassOptionsToPackage
                      {backend=biber,style=abnt-numeric}{biblatex}
                  }
                \RequirePackage{biblatex}
              }
          }
          {\msg_error:nn {abntex3} {bibliography-files-missing}}
      }
    \@ifpackageloaded {biblatex}
      {\__abntex_backmatter_after_biblatex:}
      {}
  }

\cs_new_protected:Npn \__abntex_backmatter_check_biber_output:
  {
    \tl_if_eq:NnF \g__abntex_citation_system_tl {externo}
      {
        \file_if_exist:nF {\c_sys_jobname_str.bbl}
          {
            \msg_warning:nnx {abntex3} {biber-output-missing}
              {\c_sys_jobname_str}
          }
      }
  }

\cs_new_protected:Npn \abntex_backmatter_initialize:
  {
    \hook_gput_code:nnn {package/biblatex/after}
      {abntex3-backmatter}
      {\__abntex_backmatter_after_biblatex:}
    \__abntex_backmatter_load_bibliography:
  }

\NewExpandableDocumentCommand \ABNTEXcitacoes {}
  {\tl_use:N \g__abntex_citation_system_tl}

\NewDocumentCommand \ABNTEXposttextualpages {}
  {
    \clearpage
    \bool_gset_true:N \g__abntex_page_numbers_bool
    \pagestyle{abntex3}
    \thispagestyle{abntex3}
  }

\NewDocumentCommand \ABNTEXbibliografia {O{Referências} O{}}
  {
    \__abntex_backmatter_register:nn {1} {referencias}
    \bool_if:NTF \g__abntex_bibliography_ready_bool
      {
        \ABNTEXposttextualtitle{#1}
        \group_begin:
          \setstretch{1}
          \raggedright
          \tl_if_blank:nTF {#2}
            {\printbibliography[heading=none]}
            {\printbibliography[heading=none,#2]}
        \group_end:
      }
      {\msg_error:nn {abntex3} {bibliography-not-configured}}
  }

\NewDocumentCommand \ABNTEXglossario {O{Glossário} O{}}
  {
    \__abntex_backmatter_register:nn {2} {glossario}
    \cs_if_exist:NTF \printglossary
      {
        \ABNTEXposttextualtitle{#1}
        \group_begin:
          \cs_if_exist:NT \glossarysection
            {\RenewDocumentCommand \glossarysection {O{} m} {}}
          \tl_if_blank:nTF {#2}
            {\printglossary}
            {\printglossary[#2]}
        \group_end:
      }
      {
        \msg_error:nnxx {abntex3} {backmatter-integration-missing}
          {\token_to_str:N \printglossary}
          {\token_to_str:N \ABNTEXglossario}
      }
  }

\NewDocumentCommand \ABNTEXindice {O{Índice}}
  {
    \__abntex_backmatter_register:nn {5} {indice}
    \cs_if_exist:NTF \printindex
      {
        \group_begin:
          \cs_set:Npn \indexname {#1}
          \clearpage
          \__abntex_add_primary_toc:n {#1}
          \tl_set:cn {g__abntex_level_1_alignment_tl} {\centering}
          \printindex
        \group_end:
      }
      {
        \msg_error:nnxx {abntex3} {backmatter-integration-missing}
          {\token_to_str:N \printindex}
          {\token_to_str:N \ABNTEXindice}
      }
  }

\hook_gput_code:nnn {cmd/ABNTEXappendix/before}
  {abntex3-backmatter}
  {\__abntex_backmatter_register:nn {3} {apendices}}
\hook_gput_code:nnn {cmd/ABNTEXannex/before}
  {abntex3-backmatter}
  {\__abntex_backmatter_register:nn {4} {anexos}}
\hook_gput_code:nnn {enddocument}
  {abntex3-backmatter}
  {\__abntex_backmatter_check_biber_output:}

\endinput
%</package>
%    \end{macrocode}
%
% \end{implementation}
%
% \Finale
